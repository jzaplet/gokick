APP_HTTP_PORT=3000
# OrbStack dev domain used by docker-compose: app → http(s)://$APP_DOMAIN,
# docs (documan) → docs.$APP_DOMAIN. Per-project, change this one value. Only
# docker-compose uses it; `make serve` (host) is unaffected.
APP_DOMAIN=gokick.local
APP_DB_PATH=./data/app.db
# WAL is the default. Switch to DELETE when the same DB is read by another
# process via a Docker bind mount (e.g. PhpStorm browsing data/app.db while
# the container writes to it) — Docker Desktop's virtualised FS doesn't
# guarantee mmap/shm coordination that WAL requires.
APP_DB_JOURNAL_MODE=DELETE
APP_JWT_SECRET=change-me-to-at-least-32-characters-long-secret
APP_JWT_ACCESS_EXPIRATION=15m
APP_JWT_REFRESH_EXPIRATION=168h
APP_CORS_ORIGIN=http://localhost:5173
APP_COOKIE_SECURE=false

# Structured logging. Format: json (default, for aggregators like Loki) or
# text (human-readable, handy for local `make serve`). Level: debug, info
# (default), warn, error. Unknown values fall back to json / info.
APP_LOG_FORMAT=json
APP_LOG_LEVEL=info

# Required only when running `./bin/app seed`. Pick a strong password (8-128
# chars). Leave empty in environments where the seed command is never run.
APP_SEED_ADMIN_PASSWORD=

# OPTIONAL: set to seed a platform superadmin account (nickname "superadmin")
# with cross-tenant platform:overview access. Leave empty to run without a
# superadmin — the platform overview stays unreachable.
APP_SEED_SUPERADMIN_PASSWORD=

# Name of the tenant the seeded admin lands in WHEN multitenancy is on
# (find-or-create). Ignored with multitenancy off (admin stays in the default
# tenant). The superadmin always lives in the default tenant.
APP_SEED_ADMIN_TENANT=Tenant 1

# Set to true only when running behind a reverse proxy you trust to
# rewrite X-Real-IP. With this off (default), per-IP rate limiting uses
# RemoteAddr — safe but means everyone behind the proxy shares a bucket.
APP_TRUST_PROXY_HEADERS=false

# Multitenancy enforcement mode. Tenant resolution is always data-driven (the
# JWT carries the tenant); this flag only picks what happens when no tenant
# resolves. false (default): fail-open — fall back to the default tenant, so a
# single-tenant deployment runs unchanged. true: fail-closed — a missing tenant
# panics instead of silently scoping to the default tenant (a cross-tenant leak).
# Turn it on only in a deployment that actually creates multiple tenants.
APP_MULTITENANCY=false

# Per-IP token-bucket caps for auth endpoints. Format: N/sec, N/min,
# N/hour, or N/Xs|m|h. Set empty to disable.
APP_RATE_LIMIT_LOGIN=10/min
APP_RATE_LIMIT_REFRESH=60/min

# Durable run worker — drives long-running, resumable background work ("agents")
# that runs OUTSIDE a transaction and checkpoints its state (see the /gk-runs
# skill). Co-runs inside `serve` and as the standalone `worker` command. Defaults
# are safe; tune only under real load.
#   LEASE: how long a claimed run is owned before the lease must be renewed. The
#     heartbeat renews well within it; if a worker dies, the lease lapses after
#     this and another worker reclaims + resumes from the last checkpoint.
#   HEARTBEAT: lease-renewal interval. 0s (default) = worker derives Lease/3
#     (must stay well under LEASE or a busy worker risks false expiry → double-run).
#   POLL: how often a free worker slot looks for the next due run.
#   DRAIN_TIMEOUT: on SIGTERM, how long to let in-flight runs reach a checkpoint
#     before their context is cancelled (they get reclaimed + resumed elsewhere).
#   MAX_IN_FLIGHT: concurrent runs per worker (backpressure). Each agent holds
#     memory, so this is the real lever for a 500-agent fleet — size to RAM.
#   MAX_RECLAIMS: poison guard — a run reclaimed this many times (crash-looping)
#     is failed at the claim boundary instead of cycling forever. Distinct from
#     MaxRetries (logical retries); crashes must not burn the retry budget.
APP_RUN_WORKER_LEASE=5m
APP_RUN_WORKER_HEARTBEAT=0s
APP_RUN_WORKER_POLL=1s
APP_RUN_WORKER_DRAIN_TIMEOUT=10s
APP_RUN_WORKER_MAX_IN_FLIGHT=8
APP_RUN_WORKER_MAX_RECLAIMS=20

# Sentry error & panic tracking. Empty DSN = disabled (the app runs unchanged
# and ships no telemetry). Backend and frontend are separate Sentry projects,
# hence two DSNs. A Sentry DSN is public — safe to embed/expose.
#
# Backend: APP_SENTRY_DSN is read by the Go binary at runtime.
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
# Frontend: APP_SENTRY_DSN_FRONTEND is read by the Go binary at runtime and
# injected into index.html (as <meta> tags) so one built image works across
# environments. APP_SENTRY_ENVIRONMENT above is injected for the frontend too.
# The frontend release stays baked at build (VITE_SENTRY_RELEASE) since the
# image is per-version.
APP_SENTRY_DSN_FRONTEND=
# When the Go server serves the SPA in production, the VITE_* vars below are
# NOT used — they only feed the Vite dev server (`yarn dev`), where index.html
# is served directly without the Go injection.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# The release version is set automatically at build time from the git tag
# (Makefile / production Dockerfile / release workflow → main.release +
# VITE_SENTRY_RELEASE), so you normally don't set these. Override only to pin a
# release manually for a build that isn't tag-stamped.
# APP_SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=

# Sentry debug mode — when true, exposes deliberate error triggers to verify
# Sentry end-to-end on a deploy: GET /debug/sentry panics (backend) and the SPA
# shows a button that throws (frontend). The server logs a warning at startup
# when this is on. Keep it OFF in production.
APP_SENTRY_DEBUG=false

# Frontend source maps (de-minified Sentry stack traces) are a BUILD-TIME concern,
# not app runtime: set SENTRY_AUTH_TOKEN (secret) + SENTRY_ORG + SENTRY_PROJECT in
# CI / the Docker build, not here. Without them the build ships no maps. See the
# Sentry guide (docs/guides/sentry.md → Source maps).

DOCUMAN_HTTP_PORT=3005