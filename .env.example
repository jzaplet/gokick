#|--------------------------------------------------------------------------
#| APPLICATION
#|--------------------------------------------------------------------------

# Port the Go binary (`make serve`, the app container) listens on.
APP_HTTP_PORT=3000

#|--------------------------------------------------------------------------
#| LOCAL DOCKER (OrbStack)
#|--------------------------------------------------------------------------
#| No container publishes a port: OrbStack routes a domain straight to each
#| container. Keep this section first — the database DSNs below build on
#| APP_DOMAIN.

# Base domain of the project's containers: app → http(s)://$APP_DOMAIN,
# docs (documan) → docs.$APP_DOMAIN, Postgres → db.$APP_DOMAIN. Per-project,
# change this one value. `make serve` on the host listens on APP_HTTP_PORT
# regardless.
APP_DOMAIN=gokick.local

# Port of the documan (docs UI) container.
DOCUMAN_HTTP_PORT=3005

#|--------------------------------------------------------------------------
#| DATABASE
#|--------------------------------------------------------------------------
#| APP_DB_DRIVER picks the adapter. Only the block of the chosen adapter is
#| read; the other one is ignored, so both can stay filled in.

# sqlite (default) or postgres. The Postgres adapter is being built
# (docs/framework/postgres-adapter-plan.md): with postgres here, `make build` /
# `make serve` already start its Docker database on their own, but until its
# repositories land the binary refuses the driver.
# APP_DB_DRIVER=sqlite

# Connection-pool cap. Unset/0 = auto. SQLite: clamp(2×NumCPU, 4, 32) — it
# serializes writes, so this bounds MEMORY + backpressure, not throughput
# (2vCPU/2GB droplet → 4; 10-core → 20; 16-core → 32). Postgres: the cap of EACH
# of its two pools, auto clamp(2×NumCPU, 4, 16), so pools × replicas stay under
# the server's max_connections. Override only for an unusual RAM:CPU ratio.
# APP_DB_MAX_CONNS=

# --- SQLite ----------------------------------------------------------------

# The database file (the app container overrides it with /data/app.db).
APP_DB_PATH=./data/app.db

# WAL is the default. Switch to DELETE when the same DB is read by another
# process via a Docker bind mount (e.g. PhpStorm browsing data/app.db while
# the container writes to it) — Docker Desktop's virtualised FS doesn't
# guarantee mmap/shm coordination that WAL requires.
APP_DB_JOURNAL_MODE=DELETE

# --- Postgres (APP_DB_DRIVER=postgres) -------------------------------------

# One DSN per database role, all three required. The roles come from
# docker/postgres/initdb/01-roles.sh; the passwords below are its dev defaults
# (the container publishes no port — OrbStack routes db.$APP_DOMAIN to it).
# Never point APP_DB_URL at the schema owner or a superuser: row-level security
# would not apply, and the app refuses to start.
#   APP_DB_URL          tenant plane — gokick_app, bound by row-level security
#   APP_DB_SYSTEM_URL   cross-tenant plane — gokick_system (BYPASSRLS)
#   APP_DB_MIGRATE_URL  schema owner — gokick_owner, used only for the migrations
APP_DB_URL=postgres://gokick_app:gokick_app@db.${APP_DOMAIN}:5432/gokick?sslmode=disable
APP_DB_SYSTEM_URL=postgres://gokick_system:gokick_system@db.${APP_DOMAIN}:5432/gokick?sslmode=disable
APP_DB_MIGRATE_URL=postgres://gokick_owner:gokick_owner@db.${APP_DOMAIN}:5432/gokick?sslmode=disable

# Other role passwords for the Docker database: set before its first start (or
# after make db-reset) and change the DSNs above to match. The app container
# builds its own DSNs from these.
# GOKICK_APP_PASSWORD=
# GOKICK_SYSTEM_PASSWORD=
# GOKICK_OWNER_PASSWORD=

# Session limits: how long a statement waits for a row lock, the longest one
# statement may run, how long a transaction may sit idle. 0 disables one.
# APP_DB_LOCK_TIMEOUT=5s
# APP_DB_STATEMENT_TIMEOUT=30s
# APP_DB_IDLE_TX_TIMEOUT=60s

#|--------------------------------------------------------------------------
#| AUTHENTICATION (JWT + sessions)
#|--------------------------------------------------------------------------

# HS256 signing key of the access tokens — at least 32 characters.
APP_JWT_SECRET=change-me-to-at-least-32-characters-long-secret

# Lifetime of the short access token and of the refresh session.
APP_JWT_ACCESS_EXPIRATION=15m
APP_JWT_REFRESH_EXPIRATION=168h

# Secure flag of the session cookie (and HSTS). Keep true anywhere served over
# HTTPS; false only for plain-HTTP local development.
APP_COOKIE_SECURE=false

# Per-IP token-bucket caps for auth endpoints. Format: N/sec, N/min,
# N/hour, or N/Xs|m|h. Set empty to disable.
APP_RATE_LIMIT_LOGIN=10/min
APP_RATE_LIMIT_REFRESH=60/min

#|--------------------------------------------------------------------------
#| HTTP
#|--------------------------------------------------------------------------

# The ONE browser origin allowed to call the API with credentials (CORS) — exactly
# scheme://host[:port]; also the CSRF trusted origin. The default is the Vite dev
# server.
APP_CORS_ORIGIN=http://localhost:5173

# Set to true only when running behind a reverse proxy you trust to
# rewrite X-Real-IP. With this off (default), per-IP rate limiting uses
# RemoteAddr — safe but means everyone behind the proxy shares a bucket.
APP_TRUST_PROXY_HEADERS=false

#|--------------------------------------------------------------------------
#| MULTITENANCY
#|--------------------------------------------------------------------------

# Enforcement mode. Tenant resolution is always data-driven (the JWT carries
# the tenant); this flag only picks what happens when no tenant resolves.
# false (default): fail-open — fall back to the default tenant, so a
# single-tenant deployment runs unchanged. true: fail-closed — a missing tenant
# panics instead of silently scoping to the default tenant (a cross-tenant leak).
# Turn it on only in a deployment that actually creates multiple tenants.
APP_MULTITENANCY=false

#|--------------------------------------------------------------------------
#| SEEDING (./bin/app seed)
#|--------------------------------------------------------------------------

# Required only when running `./bin/app seed`. Pick a strong password (8-128
# chars). Leave empty in environments where the seed command is never run.
APP_SEED_ADMIN_PASSWORD=

# OPTIONAL: set to seed a platform superadmin account (nickname "superadmin")
# with cross-tenant platform:overview access. Leave empty to run without a
# superadmin — the platform overview stays unreachable.
APP_SEED_SUPERADMIN_PASSWORD=

# Name of the tenant the seeded admin lands in WHEN multitenancy is on
# (find-or-create). Defaults to the well-known "Default" tenant that the schema
# bootstraps, so the admin joins it rather than spinning up a second tenant; set
# a different name to seed the admin into its own. Ignored with multitenancy off
# (admin stays in the default tenant). The superadmin always lives in the default
# tenant.
APP_SEED_ADMIN_TENANT=Default

#|--------------------------------------------------------------------------
#| BACKGROUND WORKER (durable runs)
#|--------------------------------------------------------------------------
#| Drives long-running, resumable background work ("agents") that runs OUTSIDE
#| a transaction and checkpoints its state (see the /gk-runs skill). Co-runs
#| inside `serve` and as the standalone `worker` command. Defaults are safe;
#| tune only under real load.

# How long a claimed run is owned before the lease must be renewed. The
# heartbeat renews well within it; if a worker dies, the lease lapses after this
# and another worker reclaims + resumes from the last checkpoint.
APP_RUN_WORKER_LEASE=5m

# Lease-renewal interval. 0s (default) = worker derives Lease/3 (must stay well
# under LEASE or a busy worker risks false expiry → double-run).
APP_RUN_WORKER_HEARTBEAT=0s

# How often a free worker slot looks for the next due run.
APP_RUN_WORKER_POLL=1s

# On SIGTERM, how long to let in-flight runs reach a checkpoint before their
# context is cancelled (they get reclaimed + resumed elsewhere).
APP_RUN_WORKER_DRAIN_TIMEOUT=10s

# Concurrent runs per worker (backpressure). Each agent holds memory, so this is
# the real lever for a 500-agent fleet — size to RAM.
APP_RUN_WORKER_MAX_IN_FLIGHT=8

# Poison guard — a run reclaimed this many times (crash-looping) is failed at the
# claim boundary instead of cycling forever. Distinct from MaxRetries (logical
# retries); crashes must not burn the retry budget.
APP_RUN_WORKER_MAX_RECLAIMS=20

# Debug mode — when true, exposes the /debug/runs endpoints and the e2e:* run
# kinds the durable-run E2E tests drive. It lets any caller enqueue and cancel
# runs, and the server logs a warning at startup. Keep it OFF in production.
# APP_RUN_DEBUG=false

#|--------------------------------------------------------------------------
#| LOGGING
#|--------------------------------------------------------------------------

# Format: json (default, for aggregators like Loki) or text (human-readable,
# handy for local `make serve`). Level: debug, info (default), warn, error.
# Unknown values fall back to json / info.
APP_LOG_FORMAT=json
APP_LOG_LEVEL=info

#|--------------------------------------------------------------------------
#| ERROR TRACKING (Sentry)
#|--------------------------------------------------------------------------
#| Empty DSN = disabled (the app runs unchanged and ships no telemetry). Backend
#| and frontend are separate Sentry projects, hence two DSNs. A Sentry DSN is
#| public — safe to embed/expose.

# Backend: read by the Go binary at runtime.
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development

# Frontend: read by the Go binary at runtime and injected into index.html (as
# <meta> tags), so one built image works across environments.
# APP_SENTRY_ENVIRONMENT above is injected for the frontend too. The frontend
# release stays baked at build (VITE_SENTRY_RELEASE) since the image is
# per-version.
APP_SENTRY_DSN_FRONTEND=

# When the Go server serves the SPA in production, the VITE_* vars below are
# NOT used — they only feed the Vite dev server (`yarn dev`), where index.html
# is served directly without the Go injection.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# The release version is set automatically at build time from the git tag
# (Makefile / production Dockerfile / release workflow → main.release +
# VITE_SENTRY_RELEASE), so you normally don't set these. Override only to pin a
# release manually for a build that isn't tag-stamped.
# APP_SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=

# Debug mode — when true, exposes deliberate error triggers to verify Sentry
# end-to-end on a deploy: GET /debug/sentry panics (backend) and the SPA shows a
# button that throws (frontend). The server logs a warning at startup when this
# is on. Keep it OFF in production.
APP_SENTRY_DEBUG=false

# Frontend source maps (de-minified Sentry stack traces) are a BUILD-TIME concern,
# not app runtime: set SENTRY_AUTH_TOKEN (secret) + SENTRY_ORG + SENTRY_PROJECT in
# CI / the Docker build, not here. Without them the build ships no maps. See the
# Sentry guide (docs/guides/sentry.md → Source maps).
